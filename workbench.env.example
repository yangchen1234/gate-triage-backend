# Optional local overrides. Copy selected values into .env; never commit secrets.
WORKBENCH_DB_PASSWORD=gate_triage_local

# Host Python development only. Docker Compose builds its own internal URL.
WORKBENCH_DATABASE_URL=postgresql+psycopg://gate_triage:gate_triage_local@127.0.0.1:54329/gate_triage

# Optional read-only adapter / signed inbox. Live workspace activation is disabled.
T49_API_KEY=
T49_WEBHOOK_SECRET=
T49_WEBHOOK_CONNECTION=default
