# Copy to .env; never commit .env or provider credentials.
CONTAINERS_FILE=data/containers.json
SCORER=gate_triage.score:score
CONTAINERS_PER_LANE_PER_DAY=12
CORS_ORIGINS=*
LLM_REASON_LIMIT=20
# Optional shared Claude connection. Local: .env, loaded by scripts/run_yard.py.
# Hosted: set real values in Render Environment, never in GitHub.
# All three must be configured; an API key alone never enables public spending.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# Required for keys that are not scoped to a single workspace:
# ANTHROPIC_WORKSPACE_ID=wrkspc_your_workspace_id
# CONSOLE_TEAM_ACCESS_CODE=
# Use a private team code of at least 16 non-whitespace characters.
# Once your team's API adapter is ready, set its sync callable:
# CLOUD_REASONER=team_llm:explain_many
# See docs/integration.md for the contract and provider timeout requirements.

# Durable synthetic yard storage. Use a mounted persistent disk on a hosted service.
YARD_DATABASE_PATH=.local/yard.sqlite3
